POSTGRES_PASSWORD=parcourse
DB_SCHEMA=public
LOG_LEVEL=info
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Single sign-on. Leave OIDC_ISSUER empty and the button never appears; set it and the other three are required. The redirect URL must be registered with your provider exactly as written here.
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://parcourse.example.com/api/auth/oidc/callback
# What the button says. Your provider's name, or whatever your people call it.
# OIDC_NAME=SSO
# Where the browser lands afterwards. Defaults to the first entry in CORS_ORIGINS.
# OIDC_POST_LOGIN_URL=
# Whether a successful sign-in for an unknown address makes an account. Off means an admin creates people first.
# OIDC_AUTO_PROVISION=false

# Only for an external database. Leave unset and the app builds this from POSTGRES_PASSWORD; setting it here means the two can disagree.

# DATABASE_URL=postgresql://user:password@host:5432/postgres

# YouTube refuses transcript requests coming from datacenter addresses, so a deployment on a VPS needs to fetch through somewhere else. Leave this empty when running at home, where the connection is already a residential one. Takes a proxy of any kind, http:// or socks5h://, from a provider or from the VPN sidecar in docker-compose.vpn.yml. YTDLP_PROXY=http://vpn:8888

# Only read by docker-compose.ghcr-vpn.yml. These are the provider's OpenVPN credentials rather than the ones their website logs you in with.
# VPN_SERVICE_PROVIDER=protonvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=
# Set to on when the provider account is a free one.
# FREE_ONLY=off
# A refused fetch asks the VPN for a different server and tries again. This is how many times before the user is told, and zero turns it off.
# VPN_ROTATIONS=2
# Where that request is sent: gluetun's control server, which docker-compose.ghcr-vpn.yml already turns on. Rotation needs both this and VPN_ROTATIONS, and does nothing with only one of them.
# VPN_CONTROL_URL=http://vpn:8000
