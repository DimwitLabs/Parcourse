POSTGRES_PASSWORD=parcourse
DB_SCHEMA=public
LOG_LEVEL=info
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET=
ENCRYPTION_KEY=

# Only for an external database. Leave unset and the app builds this from POSTGRES_PASSWORD; setting it here means the two can disagree.

# DATABASE_URL=postgresql://user:password@host:5432/postgres

# YouTube refuses transcript requests coming from datacenter addresses, so a deployment on a VPS needs to fetch through somewhere else. Leave this empty when running at home, where the connection is already a residential one. Takes a proxy of any kind, http:// or socks5h://, from a provider or from the VPN sidecar in docker-compose.vpn.yml. YTDLP_PROXY=http://vpn:8888

# Only read by docker-compose.ghcr-vpn.yml. These are the provider's OpenVPN credentials rather than the ones their website logs you in with.
# VPN_SERVICE_PROVIDER=protonvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=
# Set to on when the provider account is a free one.
# FREE_ONLY=off
