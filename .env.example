# The bundled database's password. Set it before the first start: it is baked in when the volume is created.
POSTGRES_PASSWORD=parcourse

# The Postgres schema Parcourse keeps its tables in.
DB_SCHEMA=public

# How much the backend writes out: debug, info, warning, error, or critical.
LOG_LEVEL=info

# The port the API listens on.
BACKEND_PORT=8000

# The port the app is served on.
FRONTEND_PORT=5173

# Where the browser reaches the API. Once you are past your own machine this is the address people type, not localhost.
VITE_API_BASE_URL=http://localhost:8000

# The addresses the API accepts browser requests from, as a JSON list.
CORS_ORIGINS=["http://localhost:5173"]

# Signs everyone's session, so changing it signs everyone out.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Encrypts the AI provider keys you store, so changing it leaves the ones already saved unreadable.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=


# --- Single sign-on ---
# These reach the app through docker-compose.oidc.yml. The first four go together: set one and you need all four.

# Layers the OIDC file over whichever compose file you already run.
# COMPOSE_FILE=docker-compose.yml:docker-compose.oidc.yml

# Your provider's base address. Parcourse reads the rest from its discovery document.
# OIDC_ISSUER=https://auth.example.com

# The client your provider registered for Parcourse.
# OIDC_CLIENT_ID=

# The secret that came with that client id.
# OIDC_CLIENT_SECRET=

# Where your provider sends people back to. Register it there exactly as written here.
# OIDC_REDIRECT_URL=https://parcourse.example.com/auth/oidc/callback

# Fills the blank in "Continue with ___" on the login screen.
# OIDC_NAME=SSO

# Where the browser lands afterwards. Defaults to the first entry in CORS_ORIGINS.
# OIDC_POST_LOGIN_URL=

# Whether a sign-in from an address you have never seen makes an account. Off means an admin creates people first.
# OIDC_AUTO_PROVISION=false

# Your provider becomes the only way in: no password form, and no password an admin can set.
# OIDC_ONLY=false

# What Parcourse asks your provider for. Change it only if your provider needs a different set.
# OIDC_SCOPES=openid email profile


# --- A database you run yourself ---

# Leave this unset for the bundled one. Setting it as well as POSTGRES_PASSWORD means the two can disagree.
# DATABASE_URL=postgresql://user:password@host:5432/postgres


# --- Fetching transcripts ---
# YouTube refuses transcript requests coming from datacenter addresses, so a deployment on a VPS has to fetch through somewhere else. At home the connection is already a residential one, so leave this alone.

# A proxy of any kind, http:// or socks5h://, from a provider or from the VPN sidecar in docker-compose.vpn.yml.
# YTDLP_PROXY=http://vpn:8888


# --- The bundled VPN ---
# Only read by docker-compose.ghcr-vpn.yml.

# Which provider gluetun connects to.
# VPN_SERVICE_PROVIDER=protonvpn

# The provider's OpenVPN username, which is not the one their website logs you in with.
# OPENVPN_USER=

# The password that goes with it.
# OPENVPN_PASSWORD=

# Set this to on when the provider account is a free one.
# FREE_ONLY=off

# A refused fetch asks the VPN for a different server and tries again. This is how many times before the person is told, and zero turns it off.
# VPN_ROTATIONS=2

# Where that request is sent: gluetun's control server, which docker-compose.ghcr-vpn.yml already turns on. Rotation needs this and VPN_ROTATIONS both.
# VPN_CONTROL_URL=http://vpn:8000
